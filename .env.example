# ---------------------------------------------------------------- backend
# Where uploads, cleaned datasets, cached models and the SQLite DB are stored
# (relative paths are resolved from the VoltIQ/ project root).
VOLTIQ_DATA_DIR=data
# SQLAlchemy URL. Defaults to sqlite:///<VOLTIQ_DATA_DIR>/voltiq.db
# VOLTIQ_DATABASE_URL=sqlite:///data/voltiq.db
# Comma-separated origins allowed to call the API directly (the Vite proxy does not need this).
VOLTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VOLTIQ_MAX_UPLOAD_MB=200
# Built React app served as the website (default: frontend/dist)
# VOLTIQ_FRONTEND_DIST=frontend/dist
# Run the full validation/test model evaluation automatically after preprocessing.
VOLTIQ_AUTO_EVALUATE=true
# Minimum number of daily observations before any model is fitted.
VOLTIQ_MIN_DAILY_OBSERVATIONS=60

# ---------------------------------------------------------------- frontend (read by Vite from frontend/.env)
# VITE_PROXY_TARGET=http://127.0.0.1:8000
# VITE_API_BASE_URL=
